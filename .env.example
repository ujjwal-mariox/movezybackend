# ============================================================
# Movezy Backend — Environment Configuration
# Variable names below MUST match what src/config/index.ts reads.
# (required) = server will not start without it. (optional) = has a default / feature degrades.
# ============================================================

# ---- Core (required) ----
PORT=9050
NODE_ENV=development
DB_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=Dev"
JWTSECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"
REDIS_URL="rediss://default:<password>@<host>:6379"

# ---- JWT (optional) ----
JWT_EXPIRES_IN="30d"
JWT_ADMIN_EXPIRES_IN="8h"

# ---- AWS S3 (required — file uploads / KYC docs) ----
BUCKET="your-bucket-name"
REGION="ap-south-1"
ACCESSKEY="YOUR_AWS_ACCESS_KEY"
SECRETACCESSKEY="YOUR_AWS_SECRET_KEY"

# ---- OTP (optional) ----
# Set MASTER_OTP to a fixed value to bypass real OTP in dev/testing.
MASTER_OTP=

# ---- Payment Gateway: Razorpay (optional — payments are mocked if unset) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret. Code reads PAYMENT_WEBHOOK_SECRET first, then falls back to
# the legacy RAZORPAY_WEBHOOK_SECRET. Prefer PAYMENT_WEBHOOK_SECRET going forward.
PAYMENT_WEBHOOK_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""   # legacy alias, still honored as a fallback

# ---- Push Notifications: Firebase (optional — push is a no-op if unset) ----
# config reads FIREBASE_CREDENTIALS_PATH (path to service-account JSON file).
FIREBASE_CREDENTIALS_PATH=""
# APN (iOS) — optional
APN_KEY_ID=""
APN_TEAM_ID=""

# ---- SMS / OTP / SOS gateway: Twilio (optional — SMS is a no-op if unset) ----
# config reads SMS_PROVIDER + TWILIO_* . SOS emergency SMS depends on these.
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ---- Google Maps (optional — used for ETA/distance; falls back to Haversine) ----
GOOGLE_MAPS_API_KEY=""

# ---- MQTT (optional — secondary realtime channel; init currently disabled) ----
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# ---- Booking dispatch / fare / coins (optional — sane defaults in config) ----
# INITIAL_SEARCH_RADIUS_KM, MAX_SEARCH_RADIUS_KM, GST_PERCENTAGE,
# COIN_EARN_RATE, etc. See src/config/index.ts for the full list + defaults.
